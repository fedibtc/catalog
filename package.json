{
  "name": "fedimodboilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun i && next dev -p 3023",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "lint:all": "bun run lint:check && bun run format:check && bun run type-check",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:e2e:headed": "bunx playwright test --headed",
    "postinstall": "patch-package"
  },
  "trustedDependencies": [
    "patch-package"
  ],
  "dependencies": {
    "@fedibtc/tailwind-theme": "^1.0.5",
    "@fedibtc/ui": "^1.2.5",
    "@types/sanitize-html": "^2.16.1",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "react-qr-code": "^2.2.0",
    "react-tailwind-variants": "^1.0.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^10",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "patch-package": "^8.0.1",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2"
  }
}
